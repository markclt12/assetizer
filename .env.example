# ---------- API ----------
PORT=4000
# Public base URL of the API (used to build file URLs when the bucket is private)
API_PUBLIC_URL=http://localhost:4000
CLIENT_URL=http://localhost:5173
JWT_SECRET=change_me
JWT_EXPIRES_IN=1d

# ---------- Database (Neon) ----------
# Direct connection: used by Prisma Migrate (and at runtime if no pooled URL is set)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"
# Pooled connection (host contains -pooler): used by the app at runtime
DATABASE_URL_POOLED="postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# ---------- Seeded admin (prisma seed only) ----------
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change_me

# ---------- File storage ----------
# Configure ONE provider. Cloudinary wins if both are set.

# Option A: Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Option B: S3-compatible storage (AWS S3, Cloudflare R2, Tigris, ...)
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=auto
S3_BUCKET=
# Optional: public base URL for the bucket. If empty, files are served through
# the API (GET /api/files/*), which redirects to a short-lived signed URL.
S3_PUBLIC_BASE_URL=

# ---------- Frontend ----------
# Leave empty in development: Vite proxies /api to the API on port 4000.
VITE_API_BASE_URL=
